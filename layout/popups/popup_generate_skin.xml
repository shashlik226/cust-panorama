<root>
	<styles>
    <include src="file://{resources}/styles/gamestyles.css" />
    <include src="file://{resources}/styles/popups/popups_shared.css" />
    <include src="file://{resources}/styles/popups/popup_generic_text_entry.css" />
    <include src="file://{resources}/styles/popups/popup_generate_skin.css" />
  </styles>
  <scripts>
    	<include src="file://{resources}/scripts/common/iteminfo.js" />
  		<include src="file://{resources}/scripts/popups/popup_generate_skin.js" />
  </scripts>

  <Panel class="PopupPanel Hidden" popupbackground="dim" defaultfocus="Weapon" onload="PopupGenerateSkins.Init()">
    <Label class="PopupTitle" text="SKIN GENERATOR 3000 v2" />
	
	<Panel id="Content" class="Content">
		<Panel id="Options" class="Options">
			<Panel class="Group">
				<Label class="DropDownName" text="Weapon:" />
    			<DropDown class="PopupButton White" id="Weapon" menuclass="DropDownMenu Width-250" >
				</DropDown>
			</Panel>
			<Panel class="Group">
				<Label class="DropDownName" text="Rarity:" />
    			<DropDown class="PopupButton White" id="Rarity" menuclass="DropDownMenu Width-250">
					<Label text="Do not override"	id="dont"	value="-1"/>
					<Label style="color: color-rarity-default;" 	text="#Rarity_Default_Weapon" 		id="default" 	value="0"/>
					<Label style="color: color-rarity-common;" 		text="#Rarity_Common_Weapon" 		id="common" 	value="1"/>
					<Label style="color: color-rarity-uncommon;" 	text="#Rarity_Uncommon_Weapon" 		id="uncommon" 	value="2"/>
					<Label style="color: color-rarity-rare;" 		text="#Rarity_Rare_Weapon" 			id="rare" 		value="3"/>
					<Label style="color: color-rarity-mythical;"	text="#Rarity_Mythical_Weapon" 		id="mythical" 	value="4"/>
					<Label style="color: color-rarity-legendary;" 	text="#Rarity_Legendary_Weapon" 	id="legendary" 	value="5"/>
					<Label style="color: color-rarity-ancient;" 	text="#Rarity_Ancient_Weapon" 		id="ancient" 	value="6"/>
					<Label style="color: color-rarity-immortal;" 	text="#Rarity_Contraband_Weapon" 	id="contraband" value="7"/>
				</DropDown>
			</Panel>
			<Panel class="Group">
				<Label class="DropDownName" text="Quality:" />
    			<DropDown class="PopupButton White" id="Quality" menuclass="DropDownMenu Width-250" >
					<Label text="#normal" 			id="normal" 	value="0"/>
					<Label text="#genuine" 			id="genuine" 	value="1"/>
					<Label text="#vintage" 			id="vintage" 	value="2"/>
					<Label text="#unusual" 			id="unusual" 	value="3"/>
					<Label text="#unique" 			id="unique" 	value="4"/>
					<Label text="#community" 		id="community" 	value="5"/>
					<Label text="#developer" 		id="developer" 	value="6"/>
					<Label text="#selfmade" 		id="selfmade" 	value="7"/>
					<Label text="#customized" 		id="customized" value="8"/>
					<Label text="#strange" 			id="strange" 	value="9"/>
					<Label text="#completed" 		id="completed" 	value="10"/>
					<Label text="#haunted" 			id="haunted" 	value="11"/>
					<Label text="#tournament" 		id="tournament" value="12"/>
				</DropDown>
			</Panel>
			<Panel class="Group">
				<Label class="DropDownName" text="Paint:" />
				<DropDown class="PopupButton White" id="Paint" menuclass="DropDownMenu Width-250" >
					<Label text="Custom" id="showfromfield" value="showfromfield"/>
				</DropDown>
			</Panel>
			<Panel id="PaintFieldGroup" class="Group">
				<Label class="DropDownName" text="Paint ID:" />
    			<TextEntry maxchars="4" textmode="numeric" id="PaintField" text="2" ontextentrychange="PopupGenerateSkins.UpdateWeaponPreview()"/>
			</Panel>
			<Panel class="Group">
				<Label class="DropDownName" text="Seed:" />
    			<TextEntry maxchars="4" textmode="numeric" id="PaintSeed" class="Width-250" text="1"/>
			</Panel>
			<Panel class="Group">
				<Label class="DropDownName" text="Wear:" />
    			<TextEntry maxchars="4" textmode="numeric" id="PaintWeer" class="Width-250" text="0.00"/>
			</Panel>
			<ToggleButton id="includeStattrak" class="PopupButton Row" onactivate="PopupGenerateSkins.ChangeStattrakState()">
				<Label text="Include StatTrak™"/>
			</ToggleButton>
			<Panel id="StickersGroup" class="Group">
    			<Panel class="Stickers">
					<ItemImage src="file://{images}/icons/ui/plus.svg" id="sticker0" onactivate="PopupGenerateSkins.SelectStickerAction(0)" scaling="stretch-to-fit-preserve-aspect"/>
					<ItemImage src="file://{images}/icons/ui/plus.svg" id="sticker1" onactivate="PopupGenerateSkins.SelectStickerAction(1)" scaling="stretch-to-fit-preserve-aspect"/>
					<ItemImage src="file://{images}/icons/ui/plus.svg" id="sticker2" onactivate="PopupGenerateSkins.SelectStickerAction(2)" scaling="stretch-to-fit-preserve-aspect"/>
					<ItemImage src="file://{images}/icons/ui/plus.svg" id="sticker3" onactivate="PopupGenerateSkins.SelectStickerAction(3)" scaling="stretch-to-fit-preserve-aspect"/>
					<ItemImage src="file://{images}/icons/ui/plus.svg" id="sticker4" onactivate="PopupGenerateSkins.SelectStickerAction(4)" scaling="stretch-to-fit-preserve-aspect"/>
				</Panel>
			</Panel>
		</Panel>
	</Panel>
	<Panel class="PopupButtonRow">
		<TextButton class="PopupButton" text="COPY ITEMID" onactivate="PopupGenerateSkins.CopyItemID()" />
		<TextButton class="PopupButton" text="GENERATE" onactivate="PopupGenerateSkins.CreateItem()" />
		<TextButton class="PopupButton" text="#UI_Inspect" onactivate="PopupGenerateSkins.Inspect()" />
		<TextButton class="PopupButton" text="#UI_Cancel" onactivate="$.DispatchEvent( 'UIPopupButtonClicked', '' );" />
	</Panel>
  </Panel>
</root>

<root>
	<styles>
		<include src="file://{resources}/styles/csgostyles.css" />
		<include src="file://{resources}/styles/mainmenu.css" />
		<include src="file://{resources}/styles/mainmenu_play.css" />
		<include src="file://{resources}/styles/context_menus/context_menu_base.css" />
		<include src="file://{resources}/styles/server_browser/server_browser.css" />
	</styles>

	<snippets>
		<snippet name="serverbrowser_server">
			<Panel class="server_row">
				<Panel id="MapBackground" class="server__background" />
				<Panel class="server__gradient" hittest="false" />
            	<Panel class="server_content">
					<Panel id="server_status" class="server_status">
						<TooltipPanel id="Secure" tooltip="VAC Enabled">
							<Image texturewidth="20" textureheight="20" defaultsrc="file://{images}/icons/ui/overwatch.svg"/>
						</TooltipPanel>
						<TooltipPanel id="Password" tooltip="Required password">
							<Image texturewidth="20" textureheight="20" defaultsrc="file://{images}/icons/ui/locked.svg"/>
						</TooltipPanel>
					</Panel>
					<Panel class="server_info">
						<Image texturewidth="50" textureheight="50" id="MapIcon" defaultsrc="file://{images}/icons/ui/casual.svg"/>
						<Panel class="server_details">
							<Label html="true" class="title stratum-font" text="{s:name}" />
							<Label html="true" class="details stratum-font" text="{s:players}" />
							<Label html="true" class="details stratum-font" text="{s:map}" />
						</Panel>
					</Panel>
					<Panel id="server_buttons" class="server_buttons">
					</Panel>
				</Panel>
			</Panel>
		</snippet>
	</snippets>
					
	<ServerBrowser>
		<Panel class="top-bottom-flow map-selection-list__quick-selection-sets servers-quick-selection-sets">
			<Label id="ServerBrowserName" text="Server browser ({s:servers_count})" class="map-selection__quick-selection-set-title" />

			<Panel class="map-selection-list__quick-selection-sets__btns top-padding">

				<Button class="map-selection__quick-selection-set-icon save" onactivate="GameInterfaceAPI.ConsoleCommand('gamemenucommand openserverbrowser');">
					<Image texturewidth="24" textureheight="24" src="file://{images}/icons/ui/link.svg"/>
					<Label text="Original browser"/>
				</Button>

			</Panel>
		</Panel>
		<Panel id="info-loading" class="top-bottom-flow full-width full-height hidden">
			<Panel class="horizontal-center vertical-center top-bottom-flow" >
				<Panel class="Spinner horizontal-center vertical-center"/>
				<Label class="PopupMessage" text="#SFUI_LOADING" html="false" />
			</Panel>
		</Panel>

		<Panel id="info-nodata" class="top-bottom-flow full-width full-height hidden">
			<Panel class="horizontal-center vertical-center top-bottom-flow" >
				<Image texturewidth="48" textureheight="48" src="file://{images}/icons/ui/info.svg" class="horizontal-center vertical-center" />
				<Label id="nodata-label" class="PopupMessage" text="#SFUI_LB_NoResults" html="true" />
			</Panel>
		</Panel>

		<Panel id="info-list" class="top-bottom-flow full-width full-height hidden vscroll" style="margin-top:16px;margin-left:300px;">
		</Panel>
	</ServerBrowser>
</root>
